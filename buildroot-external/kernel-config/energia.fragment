  GNU nano 7.2                                                            buildroot-external/kernelconfig/energia.fragment *                                                                    # Sensor INA219
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_HWMON=y
CONFIG_SENSORS_INA2XX=y

# Servo: PWM por hardware no GPIO18
CONFIG_PWM=y
CONFIG_PWM_BCM2835=y

# Docker: namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Docker: cgroups
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# Docker: rede e NAT
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# Docker: armazenamento
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y

